# ============================================================================
# OR-K WORK — internal workspace module (/work). These are NOT used by the
# public marketing site, which needs no environment variables.
# Copy this file to `.env.local` and fill in the Supabase project values.
# ============================================================================

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — server-only, never exposed to the browser.
# Used for admin tasks (seeding, background jobs, storage cleanup).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for auth redirect links (magic links / password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email delivery (Resend / Vercel Marketplace)
RESEND_API_KEY=
RESEND_FROM_EMAIL=OR-K <formularios@or-k.co>
ORCA_LEADS_EMAIL=or-kk@outlook.com

# AI-assisted public company research (server-only)
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.4-mini

# Database password for `npm run db:migrate` (Project Settings → Database)
SUPABASE_DB_PASSWORD=
